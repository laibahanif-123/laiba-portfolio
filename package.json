{
  "name": "laiba-hanif-mern-portfolio",
  "version": "1.0.0",
  "description": "Professional Full Stack MERN Portfolio for Laiba Hanif – Single Project Vercel Deployment",
  "main": "api/index.js",
  "scripts": {
    "dev": "concurrently \"node server/server.js\" \"npm run dev --prefix client\"",
