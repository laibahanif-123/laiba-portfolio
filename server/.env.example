# ============================================================
# Laiba Hanif Portfolio – Backend Environment Variables (EXAMPLE)
# ============================================================
# Copy this file to .env and fill in your real values
# Never commit .env to GitHub

# MongoDB Connection URI – Atlas (Cloud)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/laiba_portfolio?retryWrites=true&w=majority

# MongoDB Connection URI – Local
# MONGO_URI=mongodb://127.0.0.1:27017/laiba_portfolio

# Server Port
PORT=5000

# Allowed Client Origin (CORS)
CLIENT_ORIGIN=http://localhost:3000
